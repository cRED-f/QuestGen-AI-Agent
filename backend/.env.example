# Set these in your terminal or load them with your preferred secrets manager.
# Only needed for the corresponding model provider:
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional local 9Router gateway key (if configured):
NINE_ROUTER_API_KEY=
QUESTGEN_9ROUTER_URL=http://127.0.0.1:20128/v1
# For a local Ollama server; defaults to http://127.0.0.1:11434
QUESTGEN_OLLAMA_URL=http://127.0.0.1:11434
# Optional custom persistent SQLite path:
# QUESTGEN_DB_PATH=./backend/data/questgen.sqlite3
# Optional: API key if your Ollama-compatible proxy requires it
QUESTGEN_OLLAMA_API_KEY=
# Optional: Fernet key to encrypt provider credentials stored through Model settings.
# If unset, QuestGen generates a private key at backend/data/.questgen-provider.key
# QUESTGEN_CREDENTIAL_ENCRYPTION_KEY=
