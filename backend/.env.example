# Set these in your terminal or load them with your preferred secrets manager.
# Only needed for the corresponding model provider:
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional local 9Router gateway key (if configured):
NINE_ROUTER_API_KEY=
QUESTGEN_9ROUTER_URL=http://127.0.0.1:20128/v1
# For a local Ollama server; defaults to http://127.0.0.1:11434
QUESTGEN_OLLAMA_URL=http://127.0.0.1:11434
# Optional custom persistent SQLite path:
# QUESTGEN_DB_PATH=./backend/data/questgen.sqlite3
# Optional: API key if your Ollama-compatible proxy requires it
QUESTGEN_OLLAMA_API_KEY=
# Optional: Fernet key to encrypt provider credentials stored through Model settings.
# If unset, QuestGen generates a private key at backend/data/.questgen-provider.key
# QUESTGEN_CREDENTIAL_ENCRYPTION_KEY=

# The currently selected chat model is also used for visual document analysis.
# Choose an actual vision-capable model in Settings. Disable explicitly if desired.
QUESTGEN_VISION_ENABLED=true
# Max image-processing calls per document; bounds provider charges.
QUESTGEN_VISION_MAX_CALLS=120
# Maximum generation tokens per vision request (default 2400). Empty/reasoning-only
# answers are retried with up to twice the configured budget (capped at 8192).
QUESTGEN_VISION_MAX_TOKENS=2400
# Optional path to LibreOffice/soffice, required for PowerPoint slide rendering.
# Linux: QUESTGEN_LIBREOFFICE_CMD=/usr/bin/soffice
# Windows (PowerShell): $env:QUESTGEN_LIBREOFFICE_CMD='C:\Program Files\LibreOffice\program\soffice.exe'
# When using a .env file on Windows, enter the path without shell quotes:
# QUESTGEN_LIBREOFFICE_CMD=C:\Program Files\LibreOffice\program\soffice.exe

# Agent Mode internet research uses the keyless ddgs Python package.
# Install backend/requirements.txt; no search API key is needed.
# Web research can still be disabled for each conversation in Agent Mode.
